<Window x:Class="PokeData.IngestionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeoData Insight - Coletor Pokemon" Height="550" Width="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBox x:Name="txtBusca" Width="130" Height="30" VerticalContentAlignment="Center" Padding="5"/>

            <ComboBox x:Name="cmbForma" Width="90" Height="30" Margin="10,0,0,0" VerticalContentAlignment="Center">
                <ComboBoxItem Content="Padrão" IsSelected="True"/>
                <ComboBoxItem Content="Mega"/>
                <ComboBoxItem Content="Mega X"/>
                <ComboBoxItem Content="Mega Y"/>
                <ComboBoxItem Content="G-Max"/>
            </ComboBox>

            <Button x:Name="btnBuscar" Content="Buscar" Width="70" Height="30" Margin="10,0,0,0" 
                    Click="btnBuscar_Click" Background="#2196F3" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <TextBlock x:Name="txtStatus" Grid.Row="1" Text="" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Border x:Name="cardResultado" Grid.Row="2" Background="#F5F5F5" CornerRadius="10" Padding="15" Visibility="Collapsed">
            <StackPanel>
                <Image x:Name="imgPokemon" Height="150" Width="150" Margin="0,0,0,10" Stretch="Uniform"/>
                <TextBlock x:Name="txtNome" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="ID:" FontWeight="Bold" Width="60"/>
                    <TextBlock x:Name="txtId" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Tipos:" FontWeight="Bold" Width="60"/>
                    <TextBlock x:Name="txtTipos" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="BST:" FontWeight="Bold" Width="60"/>
                    <TextBlock x:Name="txtBst" Foreground="DarkGreen" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Classe:" FontWeight="Bold" Width="60"/>
                    <TextBlock x:Name="txtClasse" Foreground="DarkRed" FontWeight="Bold"/>
                </StackPanel>

                <Button x:Name="btnSalvar" Content="Salvar no Firebase" Height="35" Margin="0,20,0,0" 
                        Background="#4CAF50" Foreground="White" FontWeight="Bold" Click="btnSalvar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>