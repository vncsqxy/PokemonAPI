<Window x:Class="PokeData.IngestionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeoData Insight - Coletor Pokemon" Height="580" Width="400"
        Background="#121212" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBox x:Name="txtBusca" Width="130" Height="30" VerticalContentAlignment="Center" Padding="5"
                     Background="#1E1E1E" Foreground="White" BorderBrush="#333333" CaretBrush="White"/>

            <ComboBox x:Name="cmbForma" Width="90" Height="30" Margin="10,0,0,0" VerticalContentAlignment="Center"
                      Background="#1E1E1E" Foreground="Black">
                <ComboBoxItem Content="Padrão" IsSelected="True"/>
                <ComboBoxItem Content="Mega"/>
                <ComboBoxItem Content="Mega X"/>
                <ComboBoxItem Content="Mega Y"/>
                <ComboBoxItem Content="G-Max"/>
            </ComboBox>

            <Button x:Name="btnBuscar" Content="Buscar" Width="70" Height="30" Margin="10,0,0,0" 
                    Click="btnBuscar_Click" Background="#2196F3" Foreground="White" FontWeight="Bold"
                    BorderThickness="0"/>
        </StackPanel>

        <TextBlock x:Name="txtStatus" Grid.Row="1" Text="" Foreground="#B0B0B0" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Border x:Name="cardResultado" Grid.Row="2" Background="#1E1E1E" CornerRadius="10" Padding="15" Visibility="Collapsed"
                BorderBrush="#2D2D2D" BorderThickness="1">
            <StackPanel>
                <Image x:Name="imgPokemon" Height="150" Width="150" Margin="0,0,0,10" Stretch="Uniform"/>
                <TextBlock x:Name="txtNome" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="White"/>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="ID:" FontWeight="Bold" Width="60" Foreground="#A0A0A0"/>
                    <TextBlock x:Name="txtId" Foreground="White"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Tipos:" FontWeight="Bold" Width="60" Foreground="#A0A0A0"/>
                    <TextBlock x:Name="txtTipos" Foreground="White"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="BST:" FontWeight="Bold" Width="60" Foreground="#A0A0A0"/>
                    <TextBlock x:Name="txtBst" Foreground="#4CAF50" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Classe:" FontWeight="Bold" Width="60" Foreground="#A0A0A0"/>
                    <TextBlock x:Name="txtClasse" Foreground="#FF5252" FontWeight="Bold"/>
                </StackPanel>

                <Button x:Name="btnSalvar" Content="Salvar no Firebase" Height="35" Margin="0,15,0,0" 
                        Background="#1976D2" Foreground="White" FontWeight="Bold" Click="btnSalvar_Click"
                        BorderThickness="0"/>

                <Button x:Name="btnSalvarErick" Content="SALVAR NA API ERICK" Height="35" Margin="0,10,0,0" 
                        Background="#00C853" Foreground="White" FontWeight="Bold" Click="btnSalvarErick_Click"
                        BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>